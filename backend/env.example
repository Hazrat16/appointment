# Server Configuration
PORT=5000
NODE_ENV=development

# Database
# IMPORTANT: Replace with your actual MongoDB connection string
# Local MongoDB:
MONGODB_URI=mongodb://localhost:27017/appointment_dev
# Or MongoDB Atlas (replace username, password, and cluster):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/appointment?retryWrites=true&w=majority


# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# CORS — allowed browser origins (comma-separated). Used by Express CORS middleware.
# Local Next.js default:
FRONTEND_URL=http://localhost:3000
# Example with preview port and deployed app:
# FRONTEND_URL=http://localhost:3000,https://your-frontend.example.com
