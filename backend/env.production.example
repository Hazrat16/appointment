# Production / hosted API (copy values into your host’s env UI — never commit real secrets)

# PaaS injects PORT (e.g. Render). Local Docker image default is still fine.
PORT=5000
NODE_ENV=production

# MongoDB Atlas (recommended) — Database → Connect → Drivers
# Use a dedicated DB user + strong password. Network Access: allow your PaaS egress or 0.0.0.0/0 for demos only.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/appointment?retryWrites=true&w=majority

# Generate a real value in the host UI, e.g. node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=paste-a-long-random-secret-here-not-this-literal
JWT_EXPIRE=7d

# Required: your real browser origin(s), comma-separated, no trailing slashes on the origin.
# Include every Vercel URL you use (production + preview) if previews should hit this API:
# FRONTEND_URL=https://your-app.vercel.app
FRONTEND_URL=https://your-frontend.example.com

# Required on Render / Fly / Railway / behind Nginx so rate limits see the client IP
TRUST_PROXY=true

# Optional override (default 0.0.0.0 — listen on all interfaces inside the container)
# LISTEN_HOST=0.0.0.0

# Booking policy (optional overrides)
# MIN_BOOKING_NOTICE_HOURS=2
# CANCELLATION_NOTICE_HOURS=24

# Strong JWT secret:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# Optional (future)
# SMTP_HOST=
# SMTP_PORT=
# MAX_FILE_SIZE=10485760
