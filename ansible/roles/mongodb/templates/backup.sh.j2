#!/usr/bin/env bash
# {{ ansible_managed }}
set -euo pipefail

TS="$(date -u +%Y%m%dT%H%M%SZ)"
OUT_DIR="{{ mongodb_backup_dir }}/${TS}"
mkdir -p "${OUT_DIR}"

mongodump \
  --username '{{ mongo_root_user }}' \
  --password '{{ vault_mongo_root_password }}' \
  --authenticationDatabase admin \
  --db '{{ mongo_app_db }}' \
  --out "${OUT_DIR}" \
  --quiet

tar -czf "${OUT_DIR}.tar.gz" -C "{{ mongodb_backup_dir }}" "${TS}"
rm -rf "${OUT_DIR}"

find "{{ mongodb_backup_dir }}" -maxdepth 1 -name '*.tar.gz' -mtime +{{ mongodb_backup_retention_days }} -delete
