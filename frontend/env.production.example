# Vercel (or any Next.js host) — set in Project → Settings → Environment Variables
# Production + Preview: use the same variable name; values can differ per environment.

# Public base URL of your deployed Express API, including the /api prefix (see src/lib/api.ts).
# Example after deploying the API to Render:
# NEXT_PUBLIC_API_URL=https://appointment-api-xxxx.onrender.com/api
NEXT_PUBLIC_API_URL=https://your-api-host.example.com/api

# Vercel monorepo: set Root Directory to `frontend` when importing this repository.

# Optional
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_SENTRY_DSN=
